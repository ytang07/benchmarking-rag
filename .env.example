DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABRICKS_BASE_URL=https://your-workspace.cloud.databricks.com/serving-endpoints
DATABRICKS_TOKEN=
DATABRICKS_MODEL=system.ai.gpt-oss-120b
LLM_JUDGE_ENABLED=false
LLM_JUDGE_MODEL=system.ai.qwen35-122b-a10b
BENCHMARK_SEED=7
PARSEBENCH_MAX_ROWS=1000
GOVDOCS_MAX_DOCUMENTS=100
GOVDOCS_MAX_BYTES=1000000000
GOVDOCS_MAX_DOCUMENT_BYTES=100000000
HNSW_M=16
HNSW_EF_CONSTRUCTION=128
HNSW_EF_SEARCH=40
CHUNK_SIZE=800
CHUNK_OVERLAP=80
TOP_K=10
EXACT_SCAN=true
QREL_MIN_SCORE=1
RESULTS_PATH=results/benchmark.jsonl
PERSIST_RESULTS=true
QUERY_SOURCE=
GOVDOCS_PDF_EXTRACTOR=pypdf
GOVDOCS_CONFIG=index
GOVDOCS_SPLIT=train
GOVDOCS_MAX_PAGES=20
GOVDOCS_MAX_TEXT_CHARS=200000
GOVDOCS_MAX_TEXT_BYTES=1000000
